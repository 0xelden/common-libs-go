# APP CONFIG

# secret used to sign/verify JWTs (models/auth.ParseToken) — set a real random value per environment
JWT_SECRET         = ""

APP_ENV            = "staging"
APP_TIMEZONE       = "Asia/Jakarta"
APP_HOST           = "localhost"
APP_REGISTRY_ADDR  = "127.0.0.1:6379"
APP_REGISTRY_PWD   = ""

APP_GRPC_PORT      = 8871 # must be unique
APP_GRPC_BASEPOINT = "/"
APP_GRPC_KEY       = "base_common_service" # must be unique
APP_GRPC_NAME      = "base_common_service" # must be unique

APP_HTTP_PORT      = 8872 # must be unique
APP_HTTP_BASEPOINT = "/common" # must be unique
APP_HTTP_KEY       = "common_service" # must be unique
APP_HTTP_NAME      = "common_service" # must be unique


# REDIS CONFIG
REDIS_HOST         = "127.0.0.1:6379"

# POSTGRESQL
DB_HOST            = 192.168.30.141
DB_PORT            = 5432
DB_USER            = user
DB_PWD             = pass
DB_NAME            = dbname

# OBJECT STORAGE
# Backend selector: minio (default) or azure
STORAGE_DRIVER              = minio

# MINIO (used when STORAGE_DRIVER=minio)
STORAGE_MINIO_HOST          = minio_host:9040
STORAGE_MINIO_ID            = minio_id
STORAGE_MINIO_SECRET        = minio_secret
STORAGE_MINIO_SSL           = true

# AZURE BLOB STORAGE (used when STORAGE_DRIVER=azure)
# a single line is enough:
#STORAGE_AZURE_CONNECTION_STRING = UseDevelopmentStorage=true
# For a real account, either a full connection string:
#STORAGE_AZURE_CONNECTION_STRING = DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# or account + key (endpoint optional, defaults to https://{account}.blob.core.windows.net):
#STORAGE_AZURE_ACCOUNT  = account_name
#STORAGE_AZURE_KEY      = account_key
#STORAGE_AZURE_ENDPOINT =

# Legacy unprefixed names (MINIO_*, AZURE_STORAGE_*) still work as fallback.

# APP TRACE
UPTRACE_DSN      = "http://secret@192.168.30.160:14317/2"
